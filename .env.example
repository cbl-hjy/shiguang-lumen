
# ===== 必填（无这些无法启动）=====
# DeepSeek API（拾光大脑主模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 可选（功能增强；不配置对应功能不可用，其他功能不受影响）=====
# 联网搜索-国际源（app/tools/web_search.py，Tavily 免费 1000 次/月）
TAVILY_API_KEY=
# 联网搜索-中文源（app/tools/bocha_search.py，博查免费 2000 次，open.bochaai.com 微信注册）
BOCHA_API_KEY=
# 识图/视觉理解（app/tools/vision.py，智谱 GLM-4.6V-Flash 免费，bigmodel.cn 注册）
ZHIPU_API_KEY=

# 鉴权令牌（P0 门锁）：/api/* 需 Authorization: Bearer <此值>。不配置=本地免鉴权；局域网/公网必须配置。
SHIGUANG_TOKEN=

# 备用模型端点（fallback 链：主模型挂/空返回时切换；不配置=无 fallback）
FALLBACK_MODEL=
FALLBACK_BASE_URL=
FALLBACK_API_KEY=

# ===== 运行依赖 =====
# Ollama（本地 embedding 服务，必装）：https://ollama.com 下载安装
#   - 模型：bge-m3（ollama pull bge-m3，或 ModelScope 下 GGUF 导入）
#   - 环境变量 OLLAMA_MODELS 可指向其他盘（默认用户目录）
# 数据目录（默认项目根）：DATA_DIR 环境变量可指定；EXPERIMENT_MODE=1 实验模式拦截提醒投递
