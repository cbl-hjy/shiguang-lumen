
# ===== 必填（无这些无法启动）=====
# DeepSeek API（拾光大脑）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ===== 可选（功能增强）=====
# 联网搜索（tools/web_search.py；不配置=搜索工具不可用，其他功能不受影响）
TAVILY_API_KEY=

# 鉴权令牌（P0 门锁）：/api/* 需 Authorization: Bearer <此值>。不配置=本地免鉴权；局域网/公网必须配置。
# 生成：python -c "import uuid; print(uuid.uuid4().hex*2)"
SHIGUANG_TOKEN=

# 备用模型端点（fallback 链：主模型挂/空返回时切换；不配置=无 fallback）
FALLBACK_MODEL=
FALLBACK_BASE_URL=
FALLBACK_API_KEY=

# ===== 可选（环境变量，不进 .env）=====
# DATA_DIR：数据根目录（默认项目根）。评测隔离用 DATA_DIR=data-experiment 启动实验实例
# EXPERIMENT_MODE=1：实验模式（拦截提醒投递，防止模拟用户注册真实提醒）
